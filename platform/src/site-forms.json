    "label": "Please may we have your mobile phone number",
    "type": "tel",
    "required": true
   },
   {
    "name": "company",
    "label": "If relevant, please may we have your company name?",
    "type": "text",
    "required": false
   },
   {
    "name": "please_tell_us_if_you_are",
    "label": "Please tell us if you are",
    "type": "select",
    "required": true,
    "options": [
     "The Sender",
     "A Recipient",
     "Authorised Third Party"
    ]
   },
   {
    "name": "please_give_a_brief_description_of_the_underlying_transactio",
    "label": "Please give a brief description of the underlying transaction",
    "type": "textarea",
    "required": true
   },
   {
    "name": "what_is_the_expected_amount_to_be_transferred_",
    "label": "What is the expected amount to be transferred?",
    "type": "text",
    "required": true
   },
   {
    "name": "what_is_the_expected_transfer_date_",
    "label": "What is the expected transfer date?",
    "type": "date",
    "required": true
   },
   {
    "name": "how_many_recipients_will_there_be_",
    "label": "How many recipients will there be?",
    "type": "number",
    "required": true
   },
   {
    "name": "do_you_require_any_of_the_distributions_made_in_cryptocurren",
    "label": "Do you require any of the distributions made in cryptocurrency?",
    "type": "radio",
    "required": true,
    "options": [
     "Yes",
     "No"
    ]
   },
   {
    "name": "how_confident_are_you_that_this_will_happen_",
    "label": "How confident are you that this will happen?",
    "type": "radio",
    "required": true,
    "options": [
     "Transaction has happened - just needs distribution",
     "Extremely confident",
     "Moderately Confident",
     "Just hopeful"
    ]
   }
  ],
  "intro_html": "<h3><strong>Welcome to ThePaymaster® </strong></h3> <p>Congratulations on reaching this exciting milestone! <br>You're about to take the final step in completing your deal – distributing the agreed payments smoothly and securely.</p> <h3><strong><br>Before You Begin...</strong></h3> <p>Please confirm that your transaction meets the following criteria:</p> <ul> <li>The total transaction value is £250,000 or more (exceptions for monthly recurring deals)</li> <li>Your deal is either completed or in its final stages and funds have been verified</li> <li>Before our call we need to know the full name and email of everyone that will be on the call - no exceptions!</li> <li>All parties involved are prepared to complete our verification process</li> </ul> <p><br>If you're not quite there yet, don't worry!<br><br>Bookmark this page and return when you're ready. We're excited to work with you, but starting too early might cause unnecessary delays.</p> <p>Ready to proceed? Great! Please complete the form below.<br><br><br></p>"
 },
 "contact-us": {
  "title": "Contact us",
