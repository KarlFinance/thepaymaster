 "transaction-brief": {
  "title": "Transaction brief",
  "page": "/form/",
  "submit": "Submit",
  "thanks": "/thank-you/",
  "intro_html": "<p>Welcome to ThePaymaster! Please fill out our form below to brief us on your paymaster requirements. At the end of the form please <a href=\"https://calendly.com/ka-karl/30min\" target=\"_blank\" rel=\"noopener\">book in a call with us</a> to ensure we have fully understood the brief.</p>",
  "fields": [
   {
    "name": "transaction_id",
    "label": "Please enter a Transaction ID",
    "type": "text",
    "required": true
   },
   {
    "name": "sender_first",
    "label": "Sender's Name — First",
    "type": "text",
    "required": true
   },
   {
    "name": "sender_last",
    "label": "Sender's Name — Last",
    "type": "text",
    "required": true
   },
   {
    "name": "email",
    "label": "Sender's Email",
    "type": "email",
    "required": true
   },
   {
    "name": "market_sector",
    "label": "Market Sector",
    "type": "select",
    "required": true,
    "options": [
     "Real Estate",
     "Private Placement Program",
     "Commercial Sale",
     "Commodities Sale",
     "Sports Agency",
     "Fine Arts & Rare Assets",
     "M & A",
     "Other"
    ]
   },
   {
    "name": "market_sector_other",
    "label": "If \"Other\" please write the Market Sector the funds are generated from",
    "type": "text",
    "required": false,
    "show_if": {
     "field": "market_sector",
     "in": [
      "Other"
     ]
    }
   },
   {
    "name": "remuneration",
    "label": "Is the Private Placement Remuneration",
    "type": "radio",
    "required": true,
    "options": [
     "A One-Off Payment?",
     "A Recurring Payment?"
    ]
   },
   {
    "name": "frequency",
    "label": "What frequency is the recurring payment?",
    "type": "radio",
    "required": true,
    "options": [
     "Weekly",
     "Every 10 days",
     "Fortnightly",
     "Monthly"
    ],
    "show_if": {
     "field": "remuneration",
     "in": [
      "A Recurring Payment?"
     ]
    }
   },
   {
    "name": "funds_from",
    "label": "Are the funds coming from:",
    "type": "radio",
    "required": true,
    "options": [
     "The Trading Platform directly",
     "The Sender's own account"
    ]
   },
   {
    "name": "description",
    "label": "Brief description of the project that created the funds",
    "type": "textarea",
    "required": true
   },
   {
    "name": "sending_bank",
    "label": "Name of Bank the money is being sent from",
    "type": "text",
    "required": true
   },
   {
    "name": "sending_bank_country",
    "label": "The Country the Bank is located:",
    "type": "country",
    "required": true
   },
   {
    "name": "gross_amount",
    "label": "Total Gross Amount of the Transfer",
    "type": "number",
    "required": true
   },
   {
    "name": "currency",
    "label": "Currency",
    "type": "text",
    "required": true
   },
   {
    "name": "expected_date",
    "label": "Expected date of funds transfer",
    "type": "date",
    "required": true
   },
   {
    "name": "beneficiaries",
    "label": "Number of Beneficiaries",
    "type": "select",
